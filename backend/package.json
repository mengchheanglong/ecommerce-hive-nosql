{
  "name": "marketplace-backend",
  "version": "1.0.0",
  "description": "NestJS Enterprise Backend API for Polyglot E-Commerce Platform",
  "private": true,
  "scripts": {
    "build": "tsc -b --force",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "test": "pnpm build && node --test tests/inventory.unit.test.cjs tests/web-write-boundary.unit.test.cjs tests/telemetry.unit.test.cjs",
    "test:inventory": "powershell -NoProfile -File scripts/Test-Inventory.ps1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongodb": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
